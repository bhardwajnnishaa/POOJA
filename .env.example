GEMINI_API_KEY=your_gemini_api_key_here
# Cuelinks publisher (channel) ID from your Cuelinks dashboard
NEXT_PUBLIC_CUELINKS_CID=your_cuelinks_cid_here

# Optional: your public website address, e.g. after buying a custom domain.
# On Vercel, the production domain is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=

# Optional: Amazon Associates India tracking tag, added to Amazon links when set
NEXT_PUBLIC_AMAZON_TAG=
